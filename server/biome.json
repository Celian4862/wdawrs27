{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"formatWithErrors": true,
		"lineEnding": "lf",
		"lineWidth": 80,
		"expand": "always"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		},
		"includes": [
			"**"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"bracketSpacing": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
